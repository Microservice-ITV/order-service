APP_NAME=OrderService
APP_ENV=local
APP_PORT=8001

# PHP 
PHP_CONTAINER_NAME=php
PHP_WORKING_DIR=/var/www/html
# Dev-focused startup permission fix for cross-OS bind mounts.
# Set false in stricter/prod-like environments.
AUTO_FIX_PERMISSIONS=true

# NODE 
NODE_VERSION=20
NODE_CONTAINER_NAME=node
NODE_WORKING_DIR=/app
NODE_PORT=5173

# MYSQL 
DB_CONTAINER_NAME=mysql
DB_HOST=orderservice-mysql
DB_PORT=3306
DB_PORT=3307
DB_DATABASE=auth
DB_USERNAME=root
DB_PASSWORD=your_local_secure_password
DB_ROOT_PASSWORD=your_local_root_password

# NGINX
NGINX_CONTAINER_NAME=nginx
NGINX_WORKING_DIR=/var/www/html

# NETWORK
NETWORK_NAME=itv-network

# PHPMYADMIN 
PHPMYADMIN_CONTAINER_NAME=phpmyadmin
PHPMYADMIN_PORT=8080