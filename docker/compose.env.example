# Copy to docker/compose.env (gitignored): cp docker/compose.env.example docker/compose.env
#
# APP_KEY: from local .env or: php artisan key:generate --show

APP_NAME=OrderService
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8001

APP_KEY=

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# Laravel DB — DB_HOST must be service name `mysql` inside Compose
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=order_service_db
DB_USERNAME=order
DB_PASSWORD=changeme_db

MYSQL_DATABASE=order_service_db
MYSQL_USER=order
MYSQL_PASSWORD=changeme_db
MYSQL_ROOT_PASSWORD=changeme_root

# Quote DB_* / MYSQL_* passwords if they contain # or shell-special characters.

# Avoid Redis dependency in minimal Docker dev (matches CACHE_STORE below)
# File-backed avoids needing a `sessions` table migration in fresh Docker DB
SESSION_DRIVER=file
CACHE_STORE=database
QUEUE_CONNECTION=database

JWT_SECRET=change-me-min-32-chars-match-auth-strategy

# Internal HTTP targets from inside containers use host.docker.internal (Mac/Win Docker Desktop)
# or your gateway IP on Linux. Browsers / frontend still use localhost ports on the host.
PRODUCT_SERVICE_URL=http://host.docker.internal:5001
PRODUCT_SERVICE_API_KEY=change-me-match-product-service

PAYMENT_SERVICE_URL=http://host.docker.internal:5003
PAYMENT_SERVICE_API_KEY=change-me-match-payment-service

# RabbitMQ (required for `docker compose --profile consumers up`). Use CloudAMQP or local broker.
RABBITMQ_HOST=
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/
RABBITMQ_SSL=false
RABBITMQ_EXCHANGE=order_events

RABBITMQ_QUEUE_PAYMENT_COMPLETED=order_service.payment.completed.queue
RABBITMQ_QUEUE_PAYMENT_FAILED=order_service.payment.failed.queue
RABBITMQ_QUEUE_PRODUCT_RESERVED=product.stock.reserved.queue
RABBITMQ_QUEUE_PRODUCT_REJECTED=product.stock.rejected.queue
RABBITMQ_QUEUE_PRODUCT_STOCK_CONFIRMED=order_service.product.stock.confirmed.queue

RECAPTCHA_SECRET_KEY=

# CORS — SPA on Vite :5173 and Dockerized frontend :3000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional host port if 8001 is taken (e.g. local artisan serve)
# ORDER_HTTP_PORT=8081

# Optional one-shot migrations on container start (prefer CI for multi-replica prod)
# RUN_MIGRATIONS=false